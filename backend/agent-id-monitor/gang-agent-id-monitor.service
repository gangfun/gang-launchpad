[Unit]
Description=Gang Fun SPACE ID Agent ID monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/gang-launchpad/backend/agent-id-monitor
Environment=GANG_RPC_URLS=https://bsc-rpc.publicnode.com,https://bsc.publicnode.com
Environment=GANG_AGENT_ID=0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F
# Set to current tip on first deploy (same idea as indexer GANG_START_BLOCK).
Environment=GANG_MONITOR_START_BLOCK=128945672
Environment=GANG_BATCH=50
Environment=GANG_MONITOR_STATE=/var/lib/gang/agent-id-monitor.state.json
# Optional: Slack/Discord/generic JSON webhook
# Environment=GANG_ALERT_WEBHOOK=https://hooks.slack.com/services/...
Environment=GANG_ALERT_MIN_SEVERITY=medium
# Environment=GANG_ALERT_LOG_MINTS=1
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
